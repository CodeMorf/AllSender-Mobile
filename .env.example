# AllSender Mobile — configuración nativa
EXPO_PUBLIC_ALLSENDER_BASE_URL=https://auth.allsender.tech

# Identificador público first-party de AllSender Mobile. No agregar client_secret.
EXPO_PUBLIC_ALLSENDER_CLIENT_ID=allsender-mobile

# Debe estar registrado exactamente en la OAuth App.
EXPO_PUBLIC_ALLSENDER_REDIRECT_URI=allsender://oauth/callback

# Proyecto EAS usado para Expo Push Notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Foreground sync con la API real /api/chat-mobile/*. Mínimo aplicado: 1500 ms.
EXPO_PUBLIC_ALLSENDER_SYNC_INTERVAL_MS=2500
